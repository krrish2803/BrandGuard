# BrandGuard environment variables — copy to `.env` and fill in.
# `.env` is gitignored; this file (with placeholders) is committed.

# ── Server ────────────────────────────────────────────────────────────────
# Port the Express server binds to (Render sets this automatically).
PORT=4000

# Secret used to HMAC demo session tokens. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# ── Database ──────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. If unset or unreachable the server falls
# back to an in-memory store (fine for the demo, data won't persist).
# MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=brandguard

# Force the in-memory store even if Mongo is reachable (local dev / tests).
# BRANDGUARD_FORCE_MEMORY=1

# ── AI judgment (F4) ──────────────────────────────────────────────────────
# BrandGuard uses NVIDIA NIM for AI judgment. Without a key the app still
# works: deterministic checks run and the AI panel discloses "AI not configured".
NVIDIA_API_KEY=your-nvidia-nim-api-key
# Model to call on NVIDIA's OpenAI-compatible endpoint. Must be one your
# account has access to (list them: GET https://integrate.api.nvidia.com/v1/models).
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Milliseconds before an AI call is aborted (F18). On timeout → deterministic.
AI_TIMEOUT_MS=8000

# Mask emails/phones in content before it is sent to the AI provider.
# AI_REDACT_PII=1
